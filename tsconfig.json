{
  "compilerOptions": {
    "module": "NodeNext",
    "target": "ES2022",
    "lib": ["ES2024"],
    "moduleResolution": "NodeNext",
    "strict": true,
    "removeComments": false,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": [
    "index.ts",
    "local.ts",
    "matrix-build.ts",
    "worker.ts",
    "postprocess.ts",
    "sources/**/*.ts",
    "tests/**/*.ts"
  ]
}
